{
  // Tooling that runs on Node: root config files and the Playwright e2e tests.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["es2023"],
    "module": "nodenext",
    "types": ["node"]
  },
  "include": ["*.ts", "e2e"]
}
