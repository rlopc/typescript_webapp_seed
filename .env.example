# Copy to `.env.local` (git-ignored) to override the defaults locally.
#
# Variables prefixed with `VITE_` are inlined into the bundle at build time and
# are PUBLIC: anyone who loads the app can read them. Never put secrets here.

# Base URL of the backend API, used by the browser. Default: /api
# VITE_API_BASE_URL=/api

# Dev server only (not exposed to the browser): where `pnpm dev` proxies `/api`.
# Default: http://localhost:3000
# API_PROXY_TARGET=http://localhost:3000
